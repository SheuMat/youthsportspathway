# Copy to .env and fill in. NEVER commit .env. Never put these values in frontend code.
PORT=8000
# Public URL of the site, used for GoCardless redirect URLs (no trailing slash)
PUBLIC_BASE_URL=http://localhost:8000
# SQLite file location
DATABASE_PATH=./data/ysp.sqlite

# ── Admin page (/admin.html) ── long random string, e.g. `openssl rand -hex 24`
ADMIN_TOKEN=

# ── GoCardless ──
# sandbox | live. Live is refused unless GOCARDLESS_LIVE_APPROVED=true.
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=
GOCARDLESS_LIVE_APPROVED=false

# ── Billing decisions (owner to confirm before enabling) ──
# When true, a subscription is created automatically once a mandate is active.
# Leave false until billing date, start date and cancellation policy are agreed.
BILLING_AUTO_CREATE_SUBSCRIPTIONS=false
# Optional fixed collection day (1-28, or -1 for last day). Blank = GoCardless default
# (first collection as soon as possible, then monthly on that date).
BILLING_DAY_OF_MONTH=

# ── Email notifications (optional; requires `npm install`) ──
# For Gmail use an App Password, not the account password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=youthsportspathway@gmail.com
NOTIFY_TO=youthsportspathway@gmail.com
